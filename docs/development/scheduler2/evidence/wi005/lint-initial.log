	wake, hasWake := decision.Wake(next)
	if hasWake && (!hadWake || oldWake != wake) {
		ctx.AddTask(s, chasm.TaskAttributes{ScheduledTime: time.Unix(0, wake)},
			&scheduler2pb.StartTask{OperationId: next.Operation.ID})
	}
