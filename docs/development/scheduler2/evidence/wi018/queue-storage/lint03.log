	q := s.IndexedQueue
	if q == nil {
		return decision.QueueSummary{}, nil
	}
	if q.FormatVersion != 1 || q.Generation == 0 || q.Version == 0 || q.NextSequence == 0 || len(s.Queue) != 0 {
		return decision.QueueSummary{}, serviceerror.NewInternal("invalid indexed queue format")
