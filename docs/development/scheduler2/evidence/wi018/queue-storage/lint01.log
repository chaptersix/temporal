func (s *Scheduler) planQueueDrain(ctx chasm.Context, state decision.State, now, catchup int64) (*decision.QueueDrainPlan, error) {
	if err := decision.ValidateQueueSummary(state); err != nil {
		return nil, err
	}
	if catchup < 0 {
		return nil, serviceerror.NewInvalidArgument("catchup window must be nonnegative")
	}
	if !state.IndexedQueue.Enabled {
		return nil, serviceerror.NewInternal("queue planner requires indexed state")
	}
	if state.IndexedQueue.Maintenance || state.Root.BlockingOperationID != "" || decision.QueueLength(state) == 0 {
		return nil, nil
	}
	b, err := s.queuePlanBatch(ctx, state)
	if err != nil {
		return nil, err
	}
	defer b.Abort()
	p := &decision.QueueDrainPlan{Fence: decision.QueueDrainFence{Summary: state.IndexedQueue, Root: state.Root, Capacity: state.Capacity, Now: now, Catchup: catchup}}
	automatic := !state.Root.Paused && (!state.Root.Limited || state.Root.Remaining > 0)
	threshold := queueThreshold(now, catchup)
	var eligible [6]int64
	var first, last queueindex.SequenceEntry
	firstClass, selectedClass := 0, 0
	for class, count := range state.IndexedQueue.Counts {
		if class < 3 && !automatic {
			p.Ineligible[class] = count
			continue
		}
		lower := queueindex.CountKey{}
		if class < 3 {
			lower = threshold
		}
		n, err := b.SequenceCount(queueIndex(state.IndexedQueue.Generation, class), 0, math.MaxUint64, lower)
		if err != nil {
			return nil, err
		}
		if n > uint64(count) {
			return nil, serviceerror.NewInternal("queue class count mismatch")
		}
		eligible[class] = int64(n)
		p.Ineligible[class] = count - int64(n)
		if n == 0 {
			continue
		}
		e, ok, err := b.SequenceExtreme(queueIndex(state.IndexedQueue.Generation, class), lower, false)
		if err != nil {
			return nil, err
		}
		if !ok {
			return nil, serviceerror.NewInternal("queue eligible extreme absent")
		}
		if first.Sequence == 0 || e.Sequence < first.Sequence {
			first = e
			firstClass = class
		}
		if class%3 != 0 {
			e, ok, err = b.SequenceExtreme(queueIndex(state.IndexedQueue.Generation, class), lower, true)
			if err != nil {
				return nil, err
			}
			if !ok {
				return nil, serviceerror.NewInternal("queue effect extreme absent")
			}
			if e.Sequence > last.Sequence {
				last = e
				selectedClass = class
			}
		}
	}
	if first.Sequence == 0 {
		return validatedQueuePlan(state, p)
	}
	if last.Sequence == 0 {
		last = first
		selectedClass = firstClass
	}
	p.Selected = true
	p.FirstSequence = first.Sequence
	p.FirstClass = firstClass
	p.SelectedSequence = last.Sequence
	if state.QueueChange.Appended && last.Sequence == s.IndexedQueue.NextSequence {
		p.Candidate = state.QueueChange.Append
	} else {
		record, ok := s.QueueRecords.Get(ctx, queueRecordKey(last.Sequence))
		if !ok {
			return nil, serviceerror.NewInternal("selected queue record absent")
		}
		p.Candidate = decodeQueued(record)
	}
	if decision.QueueClass(p.Candidate) != selectedClass || queueTime(p.Candidate) != last.Time {
		return nil, serviceerror.NewInternal("selected queue record mismatch")
	}
	for class, n := range eligible {
		replaced := int64(0)
		lower := queueindex.CountKey{}
		if class < 3 {
			lower = threshold
		}
		if class%3 != 0 && n > 0 {
			count, err := b.SequenceCount(queueIndex(state.IndexedQueue.Generation, class), 0, last.Sequence-1, lower)
			if err != nil {
				return nil, err
			}
			if count > uint64(n) {
				return nil, serviceerror.NewInternal("queue supersession count mismatch")
			}
			replaced = int64(count)
		} else if class == firstClass && first.Sequence < last.Sequence {
			replaced = 1
		}
		p.Superseded[class] = replaced
		p.Retained[class] = n - replaced
		if class == selectedClass {
			p.Retained[class]--
		}
	}
	return validatedQueuePlan(state, p)
}
