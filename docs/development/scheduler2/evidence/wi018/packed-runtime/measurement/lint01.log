			continue
		}
		target := next.Operation
		if target == nil || target.ID != effect.TargetID {
			targetState, err := s.stateFor(ctx, effect.TargetID)
			if err != nil {
				return decision.State{}, nil, err
			}
			target = targetState.Operation
		}
		if target == nil {
