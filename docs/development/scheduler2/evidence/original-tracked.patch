+// CommitCheckpoint stores a detached, serialized snapshot in this test engine's
+// simulated storage. Closing a transaction alone does not update this checkpoint.
+// Physical task queues and external effects are not part of this storage model.
+func (e *Engine) CommitCheckpoint(ref chasm.ComponentRef) error {
+	x, err := e.executionForRef(ref)
+	if err != nil {
+		return err
+	}
+	if x.node.IsDirty() {
+		return errors.New("cannot checkpoint a dirty CHASM tree")
+	}
+	nodes := make(map[string][]byte)
+	for path, node := range x.node.Snapshot(nil).Nodes {
+		data, err := proto.Marshal(node)
+		if err != nil {
+			return fmt.Errorf("serialize node %q: %w", path, err)
+		}
+		nodes[path] = data
+	}
+	state, err := proto.Marshal(x.backend.GetExecutionState())
+	if err != nil {
+		return fmt.Errorf("serialize execution state: %w", err)
+	}
+	metadata, err := json.Marshal(checkpointMetadata{State: state, TransitionCount: x.backend.CurrentVersionedTransition().TransitionCount, CreateRequestID: x.createRequestID, RequestIDs: x.requestIDs})
+	if err != nil {
+		return fmt.Errorf("serialize checkpoint metadata: %w", err)
+	}
+	e.checkpoints[newRunKey(x.key)] = executionCheckpoint{nodes: nodes, metadata: metadata}
+	return nil
+}
+
+// CrashAndReload discards volatile state and rebuilds the execution from the last
+// simulated checkpoint. It does not restore or publish physical queue tasks.
+func (e *Engine) CrashAndReload(ref chasm.ComponentRef) error {
+	current, err := e.executionForRef(ref)
+	if err != nil {
+		return err
+	}
+	saved, ok := e.checkpoints[newRunKey(current.key)]
+	if !ok {
+		return errors.New("no checkpoint for execution")
+	}
+	nodes := make(map[string]*persistencespb.ChasmNode, len(saved.nodes))
+	for path, data := range saved.nodes {
+		node := &persistencespb.ChasmNode{}
+		if err := proto.Unmarshal(data, node); err != nil {
+			return fmt.Errorf("deserialize node %q: %w", path, err)
+		}
+		nodes[path] = node
+	}
+	var metadata checkpointMetadata
+	if err := json.Unmarshal(saved.metadata, &metadata); err != nil {
+		return fmt.Errorf("deserialize checkpoint metadata: %w", err)
+	}
+	state := &persistencespb.WorkflowExecutionState{}
+	if err := proto.Unmarshal(metadata.State, state); err != nil {
+		return fmt.Errorf("deserialize execution state: %w", err)
+	}
+	restored := e.newExecution(current.key)
+	restored.restoreBackend(metadata.TransitionCount, state)
+	restored.createRequestID = metadata.CreateRequestID
+	restored.requestIDs = maps.Clone(metadata.RequestIDs)
+	restored.node, err = chasm.NewTreeFromDB(nodes, e.registry, e.timeSource, restored.backend, chasm.DefaultPathEncoder, e.logger, e.metrics)
+	if err != nil {
+		return fmt.Errorf("reload CHASM tree: %w", err)
+	}
+	root, err := restored.node.Component(chasm.NewContext(context.Background(), restored.node), chasm.ComponentRef{})
+	if err != nil {
+		return fmt.Errorf("reload root component: %w", err)
+	}
+	var rootOK bool
+	restored.root, rootOK = root.(chasm.RootComponent)
+	if !rootOK {
+		return fmt.Errorf("reloaded root %T is not a root component", root)
+	}
+	e.allExecutions[newRunKey(restored.key)] = restored
+	if e.currentExecutions[newBusinessKey(restored.key)] == current {
+		e.currentExecutions[newBusinessKey(restored.key)] = restored
+	}
+	return nil
+}
