func (s *Scheduler) demands(ctx chasm.Context) ([]workDemand, time.Time) {
	var demands []workDemand
	var future time.Time
	now := ctx.Now(s)
	if !s.HasGenerator {
		return nil, future
	}
	g := s.Generator.Get(ctx)
	state := s.stateFor(ctx, "")
	if decision.NeedsDrain(state) {
		demands = append(demands, workDemand{class: scheduler2pb.WORK_CLASS_DRAIN, key: "drain", operation: decision.DrainIndex(state, now.UnixNano(), g.CatchupWindow) >= 0})
	}
	if len(s.Manuals) > 0 {
		m := s.Manuals[0]
		demands = append(demands, workDemand{class: scheduler2pb.WORK_CLASS_MANUAL, key: fmt.Sprintf("manual/%d", m.Id), vacancy: true, operation: s.directAdmission(resolvedPolicy(m.Policy, s.Policy))})
	}
	if b := s.selectedBackfill(); b != nil {
		scan := backfillNeedsScan(g, b)
		key := fmt.Sprintf("backfill/%d", b.Id)
		if !scan {
			key = fmt.Sprintf("backfill/%d/%d", b.Id, b.Continuation.Pending.Nominal)
		}
		demands = append(demands, workDemand{class: scheduler2pb.WORK_CLASS_BACKFILL, key: key, scan: scan, vacancy: !scan, operation: !scan && s.directAdmission(resolvedPolicy(b.Policy, s.Policy))})
	}
	if g.Armed {
		at := time.Unix(0, g.WakeAt)
		if at.After(now) {
			future = at
		} else {
			pending := g.Continuation.Pending
			d := workDemand{class: scheduler2pb.WORK_CLASS_AUTOMATIC, key: "scan", scan: pending == nil || pending.Excluded}
			if !d.scan {
				d.key = fmt.Sprintf("automatic/%d/%d", pending.Revision, pending.Nominal)
				if pending.Actual > now.UnixNano() {
					return demands, time.Unix(0, pending.Actual)
				}
				eligible := !s.Paused && (!s.Limited || s.Remaining > 0) && (now.UnixNano() <= pending.Actual || now.UnixNano()-pending.Actual <= g.CatchupWindow)
				if eligible {
					if s.directAdmission(resolvedPolicy(s.Policy, s.Policy)) {
						d.operation = s.Unfinished < 4
					} else {
						p := resolvedPolicy(s.Policy, s.Policy)
						d.vacancy = len(s.Queue) < 4 && p != enumspb.SCHEDULE_OVERLAP_POLICY_SKIP && (p != enumspb.SCHEDULE_OVERLAP_POLICY_BUFFER_ONE || len(s.Queue) == 0)
					}
				}
			}
			demands = append(demands, d)
		}
	}
	return demands, future
}
